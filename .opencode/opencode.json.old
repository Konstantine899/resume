{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/qwen2.5-coder:7b-instruct-q4_K_M",
  "small_model": "ollama/deepseek-coder:1.3b-instruct-q4_K_M",
  "logLevel": "INFO",
  "snapshot": true,
  "instructions": [".opencode/docs/AGENTS.md", ".opencode/instructions/orchestrator-guide.md"],

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": {
    "default": {
      "edit": {"action": "ask"},
      "read": {"action": "allow"},
      "write": {"action": "ask"},
      "grep": {"action": "allow"},
      "glob": {"action": "allow"},
      "patch": {"action": "ask"},
      "webfetch": {"action": "allow"},
      "websearch": {"action": "allow"},
      "skill": {"action": "allow"},
      "todowrite": {"action": "allow"},
      "question": {"action": "allow"},
      "bash": {
        "npm install": {"action": "allow"},
        "npm ci": {"action": "allow"},
        "npm run build": {"action": "allow"},
        "npm run dev": {"action": "allow"},
        "npm run test": {"action": "allow"},
        "npm run lint": {"action": "allow"},
        "npm run type-check": {"action": "allow"},
        "npm run format": {"action": "allow"},
        "npm run *": {"action": "ask"},
        "npx *": {"action": "ask"},
        "git status": {"action": "allow"},
        "git diff": {"action": "allow"},
        "git log *": {"action": "allow"},
        "git branch *": {"action": "allow"},
        "git checkout *": {"action": "allow"},
        "git add *": {"action": "allow"},
        "git commit *": {"action": "ask"},
        "git push *": {"action": "ask"},
        "*": {"action": "ask"}
      },
      "external_directory": {
        "D:/Dev/tools/DBObsidian/**": {"action": "allow"},
        "**/node_modules/**": {"action": "deny"},
        "**/.git/**": {"action": "deny"},
        "**/*.env*": {"action": "deny"},
        "**/.env": {"action": "deny"},
        "**/.env.*": {"action": "deny"},
        "**/package-lock.json": {"action": "deny"},
        "**/pnpm-lock.yaml": {"action": "deny"},
        "**/yarn.lock": {"action": "deny"},
        "*": {"action": "allow"}
      }
    },
    "agents": {
      "review": {
        "edit": "deny",
        "read": "allow",
        "write": "deny",
        "grep": "allow",
        "glob": "allow",
        "patch": "deny",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "git status": { "action": "allow" },
          "git diff *": { "action": "allow" },
          "git log *": { "action": "allow" },
          "npm run lint": { "action": "allow" },
          "npm run type-check": { "action": "allow" },
          "*": { "action": "deny" }
        },
        "external_directory": {
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "**/*.env*": { "action": "deny" },
          "*": { "action": "allow" }
        }
      },
      "fsd-validator": {
        "edit": "allow",
        "read": "allow",
        "write": "ask",
        "grep": "allow",
        "glob": "allow",
        "patch": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npx madge --circular *": { "action": "allow" },
          "git mv *": { "action": "ask" },
          "git status": { "action": "allow" },
          "git diff *": { "action": "allow" },
          "*": { "action": "ask" }
        },
        "external_directory": {
          "src/**": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "**/*.env*": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "fsd-import-validator": {
        "edit": "deny",
        "read": "allow",
        "write": "deny",
        "grep": "allow",
        "glob": "allow",
        "patch": "deny",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npx madge --circular *": { "action": "allow" },
          "git diff *": { "action": "allow" },
          "*": { "action": "deny" }
        },
        "external_directory": {
          "src/**": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "ui": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "patch": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npm run lint": { "action": "allow" },
          "npm run type-check": { "action": "allow" },
          "npm run test": { "action": "allow" },
          "*": { "action": "ask" }
        },
        "external_directory": {
          "src/shared/ui/**": { "action": "allow" },
          "src/entities/**": { "action": "allow" },
          "src/features/**": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "**/*.env*": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "integration-test": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "patch": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npm run test": { "action": "allow" },
          "npm run test:*": { "action": "allow" },
          "npx vitest *": { "action": "allow" },
          "npx playwright *": { "action": "allow" },
          "*": { "action": "ask" }
        },
        "external_directory": {
          "src/**/*.test.*": { "action": "allow" },
          "src/**/*.spec.*": { "action": "allow" },
          "tests/**": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "**/*.env*": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "performance-test": {
        "edit": "ask",
        "read": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "patch": "ask",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npm run test:perf": { "action": "allow" },
          "npx vitest --benchmark *": { "action": "allow" },
          "npx lighthouse *": { "action": "ask" },
          "*": { "action": "ask" }
        },
        "external_directory": {
          "src/**": { "action": "allow" },
          "tests/perf/**": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "storybook-test": {
        "edit": "allow",
        "read": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "patch": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npm run storybook": { "action": "allow" },
          "npm run build-storybook": { "action": "allow" },
          "npx storybook *": { "action": "allow" },
          "*": { "action": "ask" }
        },
        "external_directory": {
          "src/**/*.stories.*": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "style": {
        "edit": "allow",
        "read": "allow",
        "write": "ask",
        "grep": "allow",
        "glob": "allow",
        "patch": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "npm run lint:css": { "action": "allow" },
          "npx stylelint *": { "action": "allow" },
          "*": { "action": "ask" }
        },
        "external_directory": {
          "src/**/*.scss": { "action": "allow" },
          "src/**/*.module.scss": { "action": "allow" },
          "src/shared/styles/**": { "action": "allow" },
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "*": { "action": "deny" }
        }
      },
      "orchestrator": {
        "edit": "deny",
        "read": "allow",
        "write": "deny",
        "grep": "allow",
        "glob": "allow",
        "patch": "deny",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "git status": { "action": "allow" },
          "*": { "action": "deny" }
        },
        "external_directory": {
          "**": { "action": "allow" }
        }
      },
      "prompt-refinement": {
        "edit": "ask",
        "read": "allow",
        "write": "ask",
        "grep": "allow",
        "glob": "allow",
        "patch": "ask",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "*": { "action": "ask" }
        },
        "external_directory": {
          "**/node_modules/**": { "action": "deny" },
          "**/.git/**": { "action": "deny" },
          "**/*.env*": { "action": "deny" },
          "*": { "action": "allow" }
        }
      }
    }
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "args": ["D:/Dev/projects", "D:/Dev/tools"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "args": ["--db-path", "D:/Dev/memory.db"],
      "enabled": true,
      "timeout": 120000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "args": ["--api-key", "${CONTEXT7_API_KEY}"],
      "enabled": true,
      "timeout": 120000
    },
    "eslint": {
      "type": "local",
      "command": ["npx", "-y", "@eslint/mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  },

  "formatter": true,
  "lsp": true,

  "compaction": {
    "auto": true,
    "tail_turns": 10
  },

  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  }
}
