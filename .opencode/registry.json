  "mcpServers": {
    "filesystem": {
      "type": "local",
      "status": "active",
      "command": "npx -y @modelcontextprotocol/server-filesystem",
      "roots": ["D:/Dev/projects", "D:/Dev/tools"],
      "timeout": 30000,
      "capabilities": ["read", "write", "search", "list"],
      "dependencies": []
    },
    "memory": {
      "type": "local",
      "status": "active",
      "command": "npx -y @modelcontextprotocol/server-memory",
      "dbPath": "D:/Dev/memory.db",
      "timeout": 30000,
      "capabilities": ["read", "write", "search", "create_entities", "create_relations"],
      "dependencies": []
    },
    "context7": {
      "type": "local",
      "status": "active",
      "command": "npx -y @upstash/context7-mcp",
      "timeout": 15000,
      "capabilities": ["query_docs", "resolve_library_id"],
      "dependencies": []
    },
    "eslint": {
      "type": "local",
      "status": "active",
      "command": "npx -y @eslint/mcp",
      "timeout": 30000,
      "capabilities": ["lint_files"],
      "dependencies": ["filesystem"]
    },
    "playwright": {
      "type": "local",
      "status": "active",
      "command": "npx -y @playwright/mcp",
      "timeout": 60000,
      "capabilities": ["browser_automation", "snapshot", "testing"],
      "dependencies": []
    },
    "sequential-thinking": {
      "type": "local",
      "status": "active",
      "command": "npx -y @modelcontextprotocol/server-sequential-thinking",
      "timeout": 90000,
      "capabilities": ["step_by_step_planning", "dependency_tracking", "risk_analysis"],
      "dependencies": []
    },
    "serena": {
      "type": "wsl",
      "status": "active",
      "command": "wsl --exec bash -c 'source $HOME/.local/bin/env && uvx --from git+https://github.com/oraios/serena serena start-mcp-server --context claude-code --project /mnt/d/Dev/projects/resume'",
      "timeout": 60000,
      "capabilities": [
        "find_symbol",
        "insert_after_symbol",
        "insert_before_symbol",
        "replace_symbol_body",
        "get_symbols_overview",
        "search_for_pattern",
        "find_referencing_symbols",
        "find_implementations"
      ],
      "dependencies": [],
      "fallback": "filesystem_grep"
    }
  },

