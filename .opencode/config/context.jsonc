{
  "$schema": "https://opencode.ai/context.json",

  "description": "Shared Context — общая память между агентами",

  "sharedContext": {
    "enabled": true,
    "storage": ".opencode/context/context-store.json",
    "ttl": 3600,
    "maxSize": 10485760,
    "shareBetween": [
      "review",
      "fsd-validator",
      "integration-test",
      "ui",
      "performance-test",
      "storybook-test",
    ],
    "cache": {
      "enabled": true,
      "type": "memory",
      "maxSize": 1000,
      "preload": true,
      "invalidateOn": ["write", "expire", "manual"],
      "strategy": "LRU",
      "warmup": {
        "enabled": true,
        "categories": ["patterns", "preferences"],
      },
    },
    "performance": {
      "readTimeout": 100,
      "writeTimeout": 500,
      "batchWrites": true,
      "batchInterval": 5000,
    },
  },

  "projectMemory": {
    "enabled": true,
    "storage": ".opencode/context/project-memory.json",
    "schemaVersion": "1.0.0",
    "migrations": {
      "enabled": true,
      "plugin": ".opencode/plugins/memory-versioning.js",
      "path": ".opencode/context/migrations/",
      "autoApply": true
    },
    "atomicWrite": {
      "enabled": true,
      "plugin": ".opencode/plugins/memory-atomic.js",
      "lockTimeout": 5000,
      "maxRetries": 3,
      "retryDelay": 100
    },
    "categories": {
      "decisions": {
        "enabled": true,
        "description": "Архитектурные решения",
        "ttl": 86400,
        "autoExpire": false,
      },
      "patterns": {
        "enabled": true,
        "description": "Паттерны кода",
        "ttl": 86400,
        "autoExpire": false,
      },
      "mistakes": {
        "enabled": true,
        "description": "Ошибки и исправления",
        "ttl": 604800,
        "autoExpire": true,
      },
      "preferences": {
        "enabled": true,
        "description": "Предпочтения разработчика",
        "ttl": null,
        "autoExpire": false,
      },
    },
    "backup": {
      "enabled": true,
      "frequency": "daily",
      "maxBackups": 7,
      "path": ".opencode/context/backups/",
      "compress": true,
      "onWrite": true,
      "versioned": true,
    },
    "recovery": {
      "autoRecovery": true,
      "onCorruption": "restore-from-backup",
      "onMissing": "create-new",
    },
  },

  "taskContext": {
    "enabled": true,
    "storage": ".opencode/context/task-context.json",
    "persist": true,
    "shareAcrossTasks": true,
    "maxTasks": 50,
  },

  "sync": {
    "enabled": true,
    "interval": 60,
    "onTaskComplete": true,
    "onAgentSwitch": true,
  },

  "privacy": {
    "excludePatterns": ["**/*.env", "**/package-lock.json", "**/.git/**", "**/node_modules/**"],
    "sensitiveKeys": ["password", "secret", "token", "key", "auth"],
    "encryptStorage": false,
  },

  "metrics": {
    "enabled": true,
    "trackUsage": true,
    "trackHits": true,
    "trackMisses": true,
    "logFile": ".opencode/logs/context.log",
  },

  "alerts": {
    "enabled": true,
    "rules": [
      {
        "name": "HighAgentLatency",
        "condition": "agent:p99_latency_ms > 30000",
        "severity": "warning",
        "channels": ["console", "log"]
      },
      {
        "name": "MCPCircuitOpen",
        "condition": "mcp:circuit_state == 'OPEN'",
        "severity": "critical",
        "channels": ["console", "log"]
      },
      {
        "name": "LowCacheHitRate",
        "condition": "cache:hit_rate < 0.5",
        "severity": "info",
        "channels": ["log"]
      },
      {
        "name": "HighMemoryUsage",
        "condition": "memory:write_queue_size > 100",
        "severity": "warning",
        "channels": ["console", "log"]
      },
      {
        "name": "SerenaFallbackActivated",
        "condition": "serena:fallback_active == true",
        "severity": "warning",
        "channels": ["console", "log"]
      }
    ]
  },
}
