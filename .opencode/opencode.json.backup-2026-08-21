{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/docs/AGENTS.md", ".opencode/instructions/*.md"],
  "model": "opencode/deepseek-v4-flash-free",
  "agent": {
    "guard": { "model": "ollama-cloud/qwen3.5:397b-cloud" },
    "integration-test": { "model": "ollama-cloud/qwen3.5:397b-cloud" }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "args": [
        "D:/Dev/projects/resume",
        "D:/Dev/tools",
        "D:/Dev/tools/DBObsidian/resume-app"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "serena": {
      "type": "local",
      "command": [
        "wsl",
        "--exec",
        "bash",
        "-c",
        "source $HOME/.local/bin/env && uvx --from git+https://github.com/oraios/serena serena start-mcp-server --context claude-code --project /mnt/d/Dev/projects/resume"
      ],
      "enabled": true,
      "timeout": 60000,
      "operationTimeout": {
        "find_symbol": 30000,
        "replace_symbol_body": 45000,
        "get_symbols_overview": 20000,
        "find_referencing_symbols": 30000
      },
      "fallback": {
        "enabled": true,
        "strategy": "filesystem_grep",
        "maxFiles": 50,
        "alertOnFallback": true
      }
    }
  },
  "permission": {
    "*": "ask",
    "filesystem:read": "allow",
    "filesystem:write": "allow",
    "filesystem:delete": "deny",
    "shell:git": "allow",
    "shell:dangerous": "deny",
    "bash": {
      "*": "ask",
      "git push*": "ask",
      "rm -rf *": "ask",
      "docker*": "ask",
      "gh *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  "plugin": [
    "./plugins/circuit-breaker.js",
    "./plugins/context7-cache.js",
    "./plugins/memory-atomic.js",
    "./plugins/serena-fallback.js",
    "./plugins/structured-logging.js",
    "./plugins/guard-tiered-security.js",
    "./plugins/memory-versioning.js",
    "./plugins/adaptive-parallel-mcp.js",
    "./plugins/request-deduplication.js",
    "./plugins/mcp-connection-pool.js",
    "./plugins/eslint-plugin-fsd-imports.js"
  ],
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "tail_turns": 30
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  },
  "provider": {
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "models": {
        "qwen3.5:397b-cloud": {
          "name": "Qwen 3.5 397B",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Provider",
      "models": {
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  }
}
