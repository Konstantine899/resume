{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Access token in the body (15m), refresh token in an httpOnly cookie (30d)"
          },
          "401": {
            "description": "Generic: identical for unknown account and wrong password"
          },
          "429": {
            "description": "More than 5 attempts/minute per IP+login"
          }
        },
        "summary": "Exchange credentials for an access token + refresh cookie",
        "tags": ["auth"]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Register a new user and issue a token pair",
        "tags": ["auth"]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "New access token in the body, new refresh cookie"
          },
          "401": {
            "description": "Generic: unknown, expired or reused token"
          },
          "403": {
            "description": "Cross-origin request (Origin/Sec-Fetch-Site)"
          }
        },
        "summary": "Rotate the refresh token (cookie only, access not required)",
        "tags": ["auth"]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Always 204 (idempotent)"
          }
        },
        "summary": "Revoke the whole refresh family and clear the cookie",
        "tags": ["auth"]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "id, email, role"
          },
          "401": {
            "description": "Missing, expired or invalid access token"
          }
        },
        "summary": "Current profile from a valid access token",
        "tags": ["auth"]
      }
    },
