# ============================================
# OPENCODE - RUNTIME FILES (DO NOT COMMIT)
# ============================================
# These are generated at runtime and should NOT be committed

# Runtime directories (ignore all except config files)
.opencode/logs/
.opencode/context/
.opencode/health/
.opencode/telemetry/
.opencode/backups/
.opencode/tmp/
.opencode/cache/
.opencode/node_modules/

# Log files anywhere in .opencode
.opencode/**/*.log
.opencode/**/*.log.*
.opencode/**/*.jsonl

# Runtime state files
.opencode/**/*.state
.opencode/**/*.pid
.opencode/**/*.lock

# Package files in .opencode (if any)
.opencode/package.json
.opencode/package-lock.json
.opencode/pnpm-lock.yaml
.opencode/yarn.lock

# ============================================
# OPENCODE - GLOBAL CONFIG (DO NOT COMMIT)
# ============================================
# Global OpenCode config is in user's home directory
# This should never be committed

C:/Users/Konstantine/.config/opencode/
**/.config/opencode/

