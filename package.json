{
  "name": "resume",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "analyze:scss": "tsx scripts/analyze-scss.ts",
    "analyze:dead-code": "knip --include files,dependencies,exports",
    "check:bundle": "node scripts/check-bundle.mjs public",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit --maxNodeModuleJsDepth 0",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:dev": "eslint . --ext .ts,.tsx",
    "lint:styles": "stylelint \"**/*.scss\"",
    "lint:styles:fix": "stylelint \"**/*.scss\" --fix",
    "lint:all": "npm run lint && npm run lint:styles",
    "lint:all:fix": "npm run lint:fix && npm run lint:styles:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run type-check && npm run lint:all && vitest run --coverage",
    "validate:fix": "npm run type-check && npm run lint:all:fix && npm run format",
    "validate:strict": "npm run type-check:strict && npm run lint",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook",
    "lint:storybook": "eslint .storybook/**/* --max-warnings 0",
    "validate:continue": "continue validate --fsd --style --test --quick"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "concurrently": "^10.0.5",
    "css-tree": "^3.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-fsd-imports": "^0.0.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globby": "^16.2.0",
    "gzip-size": "^7.0.0",
    "happy-dom": "^20.10.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.4.0",
    "lint-staged": "^16.4.0",
    "oxc-transform-react": "^0.147.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "pretty-bytes": "^7.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.97.3",
    "storybook": "^10.3.6",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.4.0",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
