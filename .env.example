# Vite exposes only variables prefixed with VITE_ to the client bundle.
# Copy this file to .env and fill in the values from your EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Phase 1: opt-in server/shared-assets delivery for skill SVG icons.
# Leave unset (default) to keep bundled local assets.
# VITE_SHARED_ASSETS_MODE=server
# VITE_SHARED_ASSETS_BASE_URL=http://localhost:3000
