{
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.useFlatConfig": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "stylelint.enable": true,
  "stylelint.validate": ["css", "scss", "postcss"],
  "stylelint.configFile": "./.stylelintrc.json",
  "prettier.enable": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.associations": {
    "*.module.scss": "scss",
    "*.scss": "scss"
  },

  // --- Визуализация неиспользуемого кода (TypeScript + CSS) ---
  "editor.showUnused": true,
  "editor.showDeprecated": true,

  // Подсветка неиспользуемых классов в SCSS (серым цветом)
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "entity.other.attribute-name.class.css",
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },
  "testing.automaticallyOpenTestResults": "neverOpen",

  // Проектный тест-раннер — vitest. Расширение Orta.vscode-jest находит
  // транзитивный jest (от @storybook/test-runner), гоняет его через babel-jest
  // без конфига и падает на TS-синтаксисе (inline `type` в импортах) —
  // ложные красные метки в тестах.
  "jest.enable": false
}
